# URL of the HRPulse API, including /api. Leave unset normally:
# development uses http://localhost:5005/api and production (Vercel) uses /api on the same domain.
# VITE_API_URL=http://localhost:5005/api

# Demo login box on the sign-in page. Set VITE_DEMO_LOGIN=false to hide it.
VITE_DEMO_LOGIN=true
VITE_DEMO_EMAIL=manager@test.com
VITE_DEMO_PASSWORD=123456
