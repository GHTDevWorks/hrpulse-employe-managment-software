# Copy this file to .env and fill in real values. Never commit .env.
PORT=5005
MONGO_URI=mongodb://127.0.0.1:27017/hrpulse
# (MONGODB_URI, as set by Vercel's MongoDB Atlas integration, also works)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Optional: first manager created automatically on an empty database
# SEED_EMAIL=manager@test.com
# SEED_PASSWORD=123456
# Optional: also add sample people and history on first start
# SEED_DEMO=true
